# Template: copy to `.env` (ignored by Git) and fill in. Override locally with .env.local.
# Everything prefixed with VITE_ ends up in the browser bundle: never put secrets here.

# Origin of the warranty backend (the API path prefix /v1 is added by the app).
# Empty: same origin as the page, and the dev server proxies /v1 to the backend (needed for HTTPS on a phone).
VITE_API_BASE_URL=

# HTTP timeout in milliseconds (optional, default 15000).
VITE_API_TIMEOUT_MS=15000
